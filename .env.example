# To ensure reliable connection to the Solana network, it is highly recommended to use a dedicated RPC endpoint from a provider like Helius, QuickNode, or Alchemy.
# Create a .env file in the root of the project (by copying this file) and add your RPC URL here.
# Example: REACT_APP_SOLANA_RPC_HOST=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE

REACT_APP_SOLANA_RPC_HOST=
